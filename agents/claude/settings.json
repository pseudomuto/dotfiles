{
  "permissions": {
    "allow": [
      "Skill(muto:git-commit)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/commit-msg-check.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/prose-check.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "cc-skills-golang@samber": true,
    "cloud-iam@temporal": true,
    "modern-go-guidelines@goland-claude-marketplace": true,
    "notion-workspace-plugin@notion-plugin-marketplace": true,
    "superpowers@claude-plugins-official": true,
    "muto@agentmuto": true
  },
  "extraKnownMarketplaces": {
    "agentmuto": {
      "source": {
        "source": "github",
        "repo": "pseudomuto/agentmuto"
      },
      "autoUpdate": true
    },
    "goland-claude-marketplace": {
      "source": {
        "source": "github",
        "repo": "JetBrains/go-modern-guidelines"
      },
      "autoUpdate": true
    },
    "notion-plugin-marketplace": {
      "source": {
        "source": "github",
        "repo": "makenotion/claude-code-notion-plugin"
      }
    },
    "samber": {
      "source": {
        "source": "github",
        "repo": "samber/cc"
      }
    },
    "temporal": {
      "source": {
        "source": "github",
        "repo": "temporalio/temporal-claude-marketplace"
      },
      "autoUpdate": true
    }
  }
}
