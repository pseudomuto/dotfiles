{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.codex/hooks/prose-check.sh\"",
            "timeout": 10,
            "statusMessage": "Checking prose style"
          }
        ]
      }
    ]
  }
}
